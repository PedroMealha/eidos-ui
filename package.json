{
  "name": "eidos-ui",
  "version": "3.0.0",
  "description": "A modern React component library with TypeScript and SCSS",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": {
      "types": "./dist/index.css.d.ts",
      "default": "./dist/index.css"
    },
    "./fonts": {
      "types": "./dist/fonts.css.d.ts",
      "default": "./dist/fonts.css"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "require": "./dist/*/index.cjs"
    }
  },
  "sideEffects": [
    "dist/index.css",
    "dist/index.css.d.ts",
    "dist/fonts.css",
    "dist/fonts.css.d.ts"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config vite.dev.config.ts",
    "storybook": "storybook dev -p 6007",
    "verify": "node scripts/verify.js",
    "release": "node scripts/release.js",
    "release:approve": "npm run release -- approve",
    "version:check": "npm view eidos-ui version",
    "build": "node scripts/build.js",
    "build-storybook": "storybook build",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "prepublishOnly": "npm run build",
    "version": "node scripts/promote-changelog.js",
    "postversion": "git push --follow-tags",
    "release:needed": "node scripts/release-needed.js",
    "check:docs": "node scripts/check-docs.js",
    "release:preflight": "node scripts/preflight-release.js && npm run lint && npm run typecheck && npm run prettier:check && npm run build"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "ui",
    "typescript",
    "scss"
  ],
  "author": "Pedro Mealha",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.34.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "chromatic": "^18.6.0",
    "dayjs": "^1.11.21",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.8.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sass": "^1.102.0",
    "storybook": "^10.6.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PedroMealha/eidos-ui.git"
  },
  "homepage": "https://github.com/PedroMealha/eidos-ui#readme",
  "bugs": {
    "url": "https://github.com/PedroMealha/eidos-ui/issues"
  }
}
